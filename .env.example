# Copy to .env.local and fill in real values before running locally.
# In production (Vercel), set these in Project Settings → Environment
# Variables instead of committing a .env file.

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Postgres connection string. Required — without it, every page that reads
# or writes data will throw a clear error rather than silently failing.
# - Production: use Neon's *pooled* connection string (Dashboard →
#   Connection Details → check "Pooled connection" — the hostname will
#   contain "-pooler"). This works well from many serverless instances at
#   once; the plain (non-pooled) string can run out of connections under load.
# - Local development: any local Postgres works, e.g.
#   postgresql://postgres:password@127.0.0.1:5432/garmentbazaar_dev
DATABASE_URL=

# Seeded as the one admin account the first time the database is empty.
# In production, a real (non-default) ADMIN_PASSWORD is required — the
# deploy will fail on purpose rather than launch with a guessable password.
ADMIN_EMAIL=admin@garmentbazaar.com
ADMIN_PASSWORD=changeme123

# Resend API key (resend.com → API Keys) for sending real emails — RFQ
# notifications to manufacturers today, more later. Optional: without it,
# the app still works, it just logs a warning instead of sending the email.
RESEND_API_KEY=

# The "from" address for outgoing email. Must be on a domain you've
# verified in Resend (e.g. "GarmentBazaar <quotes@garmentbazaar.com>").
# Falls back to Resend's shared test address if unset.
RESEND_FROM_EMAIL=

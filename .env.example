# Copy to .env.local and fill in real values before running locally.

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Seeded on first run if no admin account exists yet.
ADMIN_EMAIL=admin@garmentbazaar.com
ADMIN_PASSWORD=changeme123

# Razorpay (Dashboard -> Settings -> API Keys) — powers real checkout when a
# retailer orders from a brand's collection. Use TEST mode keys while
# developing (test cards, no real money moves). Without these set, ordering
# still works end to end except payment — the retailer's interest is saved
# and the brand is notified, no card is charged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
